  {
   "id": "e346580942",
   "type": "text",
   "x": 60,
   "y": 560,
   "width": 466.40000000000015,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
