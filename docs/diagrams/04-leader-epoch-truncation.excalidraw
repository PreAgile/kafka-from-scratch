   "locked": false
  },
  {
   "id": "e226315702",
   "type": "text",
   "x": 60,
   "y": 758,
   "width": 195.2,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1599129388,
   "version": 1,
   "versionNonce": 1139680216,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1758153600000,
   "link": null,
   "locked": false,
   "text": "원본 구현이 더 나쁜 이유",
   "originalText": "원본 구현이 더 나쁜 이유",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 14
  },
  {
   "id": "e2119935554",
   "type": "text",
   "x": 60,
   "y": 783,
   "width": 592.7999999999998,
   "height": 48.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 340272422,
   "version": 1,
   "versionNonce": 962992059,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1758153600000,
   "link": null,
   "locked": false,
   "text": "rebalancePartitions() 는 살아 있는 브로커 목록의 첫 번째를 새 리더로 지정한다.\n그 브로커가 이 파티션의 복제본이었는지조차 보지 않는다. 데이터를 한 바이트도 없는 브로커가\n리더가 되어 offset 0 부터 다시 쓰기 시작하면 기존 데이터는 전부 사라진다.",
   "originalText": "rebalancePartitions() 는 살아 있는 브로커 목록의 첫 번째를 새 리더로 지정한다.\n그 브로커가 이 파티션의 복제본이었는지조차 보지 않는다. 데이터를 한 바이트도 없는 브로커가\n리더가 되어 offset 0 부터 다시 쓰기 시작하면 기존 데이터는 전부 사라진다.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 11
  }
 ],
